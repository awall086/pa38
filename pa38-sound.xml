<?xml version="1.0" encoding="UTF-8"?>
 
<PropertyList>

	<fx>
 
		<crank>
			<name>engstart</name>
			<path>Sounds/engstart.wav</path>
			<property>engines/engine/cranking</property>
			<position>
				<x>-1.0</x>
				<y>0.0</y>
				<z>0.0</z>
			</position>
			<volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
			<volume>
				<offset>0.4</offset>
			</volume>
		</crank>

		<crank>
			<name>crank</name>
			<mode>looped</mode>
			<path>Sounds/cranking.wav</path>
			<condition>
				<property>engines/engine/cranking</property>
				<not>
					<property>engines/engine/running</property>
				</not>
			</condition>
			<position>
				<x>-1.0</x>
				<y>0.0</y>
				<z>0.0</z>
			</position>
   			<volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
			<volume>
				<offset>0.5</offset>
			</volume>
		</crank>

        <crank>
            <name>cough</name>
            <path>Sounds/coughing.wav</path>
            <property>/engines/engine[0]/running</property>
            <position>
                <x>-1.0</x>
                <y>0.0</y>
                <z>0.0</z>
            </position>
            <volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
            <volume>
                <offset>0.0592</offset>
            </volume>
            <reference-dist>5.0</reference-dist>
            <max-dist>200.0</max-dist>
        </crank>

        <crank>
            <name>killed</name>
            <path>Sounds/coughing.wav</path>
            <property>/sim/model/pa38/sound/click-coughing-engine-sound</property>
            <position>
                <x>-1.0</x>
                <y>0.0</y>
                <z>0.0</z>
            </position>
            <volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
            <volume>
                <offset>0.0592</offset>
            </volume>
            <reference-dist>5.0</reference-dist>
            <max-dist>200.0</max-dist>
        </crank>
		
		<engine>
			<name>engine</name>
			<mode>looped</mode>
			<path>Sounds/Continental-O-320.wav</path>
			<property>/engines/engine/running</property>
			<volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
			<volume>
				<offset>0.5857</offset>
			</volume>
			<pitch>
				<property>/engines/engine/rpm</property>
				<factor>0.0010</factor>
				<min>0.0</min>
				<max>2.5</max>
				<offset>0.01</offset>
			</pitch>
		</engine>

		<propeller>
			<name>propeller</name>
			<mode>looped</mode>
			<path>Sounds/wasp.wav</path>
			<condition>
				<greater-than>
					<property>/engines/engine/rpm</property>
					<value>10</value>
				</greater-than>
			</condition>
			<volume>
				<property>/engines/engine/rpm</property>
				<factor>0.0001</factor>
				<max>0.25</max>
			</volume>
			<volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
			<pitch>
				<property>/engines/engine/rpm</property>
				<factor>0.0004</factor>
				<min>0.0</min>
				<max>2.0</max>
				<offset>0.01</offset>
			</pitch>
		</propeller> 

        <engine-cut>
            <name>engine-cut</name>
            <mode>once</mode>
            <path>Sounds/engine-cut.wav</path>
            <condition>
                <and>
                    <not>
                        <property>/engines/engine/running</property>
                    </not>
                    <greater-than>
                        <property>/engines/engine/egt-degf</property>
                        <value>800</value>
                    </greater-than>
                </and>
            </condition>
			<volume>
                <factor>0.7143</factor>
                <property>/sim/model/pa38/sound/volume-boost-doors</property>
            </volume>
            <volume>
                <offset>0.3</offset>
            </volume>
            <reference-dist>5.0</reference-dist>
            <max-dist>200.0</max-dist>
        </engine-cut>
		
  <rumble>
   <name>rumble</name>
   <mode>looped</mode>
   <path>Sounds/rumble.wav</path>
   <condition>
    <or>
     <property>gear/gear[0]/wow</property>
     <property>gear/gear[1]/wow</property>
     <property>gear/gear[2]/wow</property>
    </or>
    <!-- <property>sim/current-view/internal</property> -->
   </condition>
   <position>
    <x>1.0</x>
    <y>0.0</y>
    <z>-1.5</z>
   </position>
   <volume>
    <property>velocities/groundspeed-kt</property>
    <type>log</type>
    <factor>0.25</factor>
   </volume>
  </rumble>

  <squeal>
   <name>squeal</name>
   <path>Sounds/squeal.wav</path>
   <condition>
    <and>
     <or>
      <property>gear/gear[0]/wow</property>
      <property>gear/gear[1]/wow</property>
      <property>gear/gear[2]/wow</property>
     </or>
     <less-than>
      <property>velocities/vertical-speed-fps</property>
      <value>-0.05</value>
     </less-than>
    </and>
   </condition>
   <position>
    <x>1.0</x>
    <y>0.0</y>
    <z>-1.5</z>
   </position>
   <volume>
    <property>velocities/groundspeed-kt</property>
    <factor>0.01</factor>
    <max>1.0</max>
   </volume>
   <volume>
    <internal>dt_stop</internal>
    <factor>0.1</factor>
    <max>1.0</max>
   </volume>
   <pitch>
    <property>velocities/groundspeed-kt</property>
    <factor>0.0025</factor>
    <offset>1.2</offset>
   </pitch>
  </squeal>
  
          <flap>
            <name>flaps</name>
            <mode>in-transit</mode>
            <path>Sounds/flaplever.wav</path>
            <property>surface-positions/flap-pos-norm</property>
            <position>
                <x>0.5</x>
                <y>0.0</y>
                <z>0.5</z>
            </position>
            <volume>
                <factor>1.0</factor>
            </volume>
            <reference-dist>10.0</reference-dist>
            <max-dist>20.0</max-dist>
        </flap>

          <fuel-pump>
            <name>fuel-pump</name>
            <mode>looped</mode>
            <path>Sounds/fuel-pump.wav</path>
            <property>controls/fuel/tank[0]/boost-pump</property>
            <position>
                <x>0.5</x>
                <y>0.0</y>
                <z>0.5</z>
            </position>
            <volume>
                <factor>1.0</factor>
            </volume>
            <reference-dist>10.0</reference-dist>
            <max-dist>20.0</max-dist>
        </fuel-pump>
        
        <switch>
            <name>click-master-batt-switch</name>
            <mode>once</mode>
            <path>Sounds/click.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-master-batt</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>
  
        <switch>
            <name>click-master-alt-switch</name>
            <mode>once</mode>
            <path>Sounds/click.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-master-alt</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-landing-light-switch</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-landing-light</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.8</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-fuel-pump</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-fuel-pump</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.8</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-strobe-switch</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-strobe</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.8</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-pitot-heat-switch</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-pitot-heat</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.8</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-fuel-selector</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-fuel-selector</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>
		
        <switch>
            <name>click-audio-switch</name>
            <mode>once</mode>
            <path>Sounds/click3.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-audio</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>-0.1200</y>
                <z>-0.0300</z>
            </position>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <dial>
            <name>click-dial</name>
            <mode>once</mode>
            <path>Sounds/scroll.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-dial</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>-0.1200</y>
                <z>-0.0300</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
            <volume>
                <factor>1.0</factor>
            </volume>
        </dial>

        <switch>
            <name>click-magneto-forward</name>
            <mode>once</mode>
            <path>Sounds/keys2.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-magneto-forward</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <volume>
                <factor>1.0</factor>
            </volume>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
            <volume>
                <factor>1.5</factor>
            </volume>
		</switch>

        <switch>
            <name>click-magneto-back</name>
            <mode>once</mode>
            <path>Sounds/keys.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-magneto-back</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>20.2</reference-dist>
            <max-dist>50.0</max-dist>
            <volume>
                <factor>1.0</factor>
            </volume>
        </switch>

        <left-door-opening>
            <name>left-door-opening</name>
            <mode>once</mode>
            <path>Sounds/door-opening.wav</path>
            <condition>
                <greater-than>
                    <property>/sim/model/door-positions/leftDoor/position-norm</property>
                    <value>0.02</value>
                </greater-than>
            </condition>
            <position>
                <x>2.15</x>
                <y>0.6</y>
                <z>0.19</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
        </left-door-opening>

        <left-door-closing>
            <name>left-door-closing</name>
            <mode>once</mode>
            <path>Sounds/door-closing.wav</path>
            <condition>
                <less-than>
                    <property>/sim/model/door-positions/leftDoor/position-norm</property>
                    <value>0.18</value>
                </less-than>
            </condition>
            <position>
                <x>2.15</x>
                <y>0.6</y>
                <z>0.19</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
        </left-door-closing>

        <right-door-opening>
            <name>right-door-opening</name>
            <mode>once</mode>
            <path>Sounds/door-opening.wav</path>
            <condition>
                <greater-than>
                    <property>/sim/model/door-positions/rightDoor/position-norm</property>
                    <value>0.02</value>
                </greater-than>
            </condition>
            <position>
                <x>2.15</x>
                <y>-0.6</y>
                <z>0.19</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
        </right-door-opening>

        <right-door-closing>
            <name>right-door-closing</name>
            <mode>once</mode>
            <path>Sounds/door-closing.wav</path>
            <condition>
                <less-than>
                    <property>/sim/model/door-positions/rightDoor/position-norm</property>
                    <value>0.18</value>
                </less-than>
            </condition>
            <position>
                <x>2.15</x>
                <y>-0.6</y>
                <z>0.19</z>
            </position>
            <reference-dist>1.5</reference-dist>
            <max-dist>50.0</max-dist>
        </right-door-closing>

        <switch>
            <name>click-rotator-switch</name>
            <mode>once</mode>
            <path>Sounds/click.wav</path>
            <condition>
                <property>/sim/model/pa38/sound/click-rotator</property>
            </condition>
            <position>
                <x>-0.3660</x>
                <y>0.3350</y>
                <z>-0.3500</z>
            </position>
            <reference-dist>2.8</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <switch>
            <name>click-primer-out</name>
            <mode>once</mode>
            <path>Sounds/primer-out.wav</path>
            <condition>
                <property>/controls/engines/engine/primer-lever</property>
            </condition>
            <volume>
                <factor>1.52</factor>
            </volume>
            <position>
                <x>1.82358</x>
                <y>-0.1000</y>
                <z>-0.1000</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-primer-in</name>
            <mode>once</mode>
            <path>Sounds/primer-in.wav</path>
            <condition>
                <not>
                    <property>/controls/engines/engine/primer-lever</property>
                </not>
            </condition>
            <volume>
                <factor>1.52</factor>
            </volume>
            <position>
                <x>1.82358</x>
                <y>-0.1000</y>
                <z>-0.1000</z>
            </position>
            <reference-dist>20.5</reference-dist>
            <max-dist>50.0</max-dist>
        </switch>

        <switch>
            <name>click-parking-brake</name>
            <mode>once</mode>
            <path>Sounds/lever.wav</path>
            <condition>
                <property>/controls/gear/brake-parking</property>
            </condition>
            <volume>
                <factor>1.90</factor>
            </volume>
            <position>
                <x>1.82358</x>
                <y>-0.1000</y>
                <z>-0.1000</z>
            </position>
            <reference-dist>30.5</reference-dist>
            <max-dist>80.0</max-dist>
        </switch>

        <switch>
            <name>click-parking-brake-dn</name>
            <mode>once</mode>
            <path>Sounds/flaplever.wav</path>
            <condition>
                <not>
					<property>/controls/gear/brake-parking</property>
				</not>
            </condition>
            <volume>
                <factor>0.1</factor>
            </volume>
            <position>
                <x>1.82358</x>
                <y>-0.1000</y>
                <z>-0.1000</z>
            </position>
            <reference-dist>5.5</reference-dist>
            <max-dist>5.0</max-dist>
        </switch>

        <stall>
            <name>stall</name>
            <mode>looped</mode>
            <path>Sounds/stall.wav</path>
            <condition>
                <and>
                    <greater-than>
                        <property>velocities/airspeed-kt</property>
                        <value>10</value>
                    </greater-than>
                    <not>
                        <property>gear/gear[0]/wow</property>
                    </not>
                </and>
            </condition>
            <position>
                <x>1.82358</x>
                <y>-0.1000</y>
                <z>-0.1000</z>
            </position>
            <volume>
                <property>/fdm/jsbsim/sounds/stall-horn-volume-actual</property>
            </volume>
            <pitch>
                <property>/fdm/jsbsim/sounds/stall-horn-pitch-actual</property>
                <offset>0.0</offset>
            </pitch>
            <reference-dist>0.5</reference-dist>
            <max-dist>50.0</max-dist>
        </stall>
 
	</fx>
 
</PropertyList>
