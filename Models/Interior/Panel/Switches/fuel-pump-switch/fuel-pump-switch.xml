<?xml version="1.0"?>

<PropertyList>

 <path>fuel-pump-switch.ac</path>

<!--	alternator switch		-->

<animation>
    <type>rotate</type>
    <object-name>fuel-pump-switch</object-name>
    <property>controls/switches/fuel-pump</property>
    <factor>-30</factor>
    <axis>
        <x>0.0</x>
        <y>1.0</y>
        <z>0.0</z>
    </axis>
    <center>
        <x-m>0</x-m>
        <y-m>0</y-m>
        <z-m>0</z-m>
    </center>
</animation>
<animation>
   <type>pick</type>
   <object-name>fuel-pump-switch</object-name>
   <visible>true</visible>
   <action>
     <button>0</button>
     <repeatable>false</repeatable>
     <binding>
       <command>property-toggle</command>
       <property>controls/switches/fuel-pump</property>
     </binding>
     <binding>
         <command>nasal</command>
         <script>pa38.click("fuel-pump")</script>
     </binding>
   </action>
   <hovered>
    <binding>
      <command>set-tooltip</command>
      <tooltip-id>Fuel-Pump-switch</tooltip-id>
      <label>Auxiliar fuel pump: %s</label>
      <mapping>on-off</mapping>
      <property>controls/switches/fuel-pump</property>
   </binding>
   </hovered>
</animation>

</PropertyList>


