<system name="engine">

    <channel name="rpm drop">

        <fcs_function name="Carb heat on causes RPM drop on engine">
            <function>
				<ifthen>
					<property>/controls/anti-ice/engine[0]/carb-heat</property>
					<value>4.9652548712</value>
					<value>0.1518538786</value>
				</ifthen>
			</function>
            <output>/sim/model/pa38/drop-factor-carb-heat</output>
        </fcs_function>
	
        <fcs_function name="single magneto selection causes RPM drop on engine">
            <function>
                <ifthen>
					<or>
						<eq>
							<property>/controls/switches/magnetos</property>
							<value>1</value>
						</eq>
						<eq>
							<property>/controls/switches/magnetos</property>
							<value>2</value>
						</eq>
					</or>
                    <value>0.7645878966</value>
                    <value>0.1518538786</value>
                </ifthen>
			</function>
            <output>/sim/model/pa38/drop-factor-magnetos</output>
        </fcs_function>

        <fcs_function name="real RPM drop on engine">
            <function>
				<max>
					<property>/sim/model/pa38/drop-factor-magnetos</property>
					<property>/sim/model/pa38/drop-factor-carb-heat</property>
				</max>
			</function>
            <output>/fdm/jsbsim/propulsion/engine[0]/air-intake-impedance-factor</output>
        </fcs_function>
	
    </channel>

    <channel name="Oil Pressure">

		<fcs_function name="/engines/engine[0]/oil-pressure">

			<function>
                <ifthen>
					<gt>
						<property>/engines/engine[0]/oil-pressure-psi</property>
						<value>0</value>
					</gt>
					<product>
						<sum>
							<value>1</value>
							<product>
								<value>5</value>
								<exp>
									<product>
										<value>-0.08</value>
										<property>/engines/engine[0]/oil-pressure-psi</property>
									</product>
								</exp>
							</product>
						</sum>
						<property>/engines/engine[0]/oil-pressure-psi</property>
					</product>
					<value>0</value>
				</ifthen>
			</function>

		</fcs_function>
		
	</channel>
	
</system>
