        <fcs_function name="/systems/pa-38/electrical/outputs/adf">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/instrumentation/adf[0]/power-btn</property>
                            <value>1</value>
                        </eq>
