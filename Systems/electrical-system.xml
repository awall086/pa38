                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/pitot-heat</property>
                        <value>0.0</value>
                    </gt>
                    <value>12.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <!-- instruments Light - Load: ~2A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/panel-light">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <gt>
                            <property>/controls/lighting/panel-lights</property>
                            <value>0</value>
                        </gt>
                        <eq>
                            <property>/controls/circuit-breakers/panel_lt</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/loads/panel-light">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/panel-light</property>
                        <value>0.0</value>
                    </gt>
                    <value>2.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>
		
        <!-- Instruments - Load: ~3A -->
        <fcs_function name="/systems/pa-38/electrical/loads/instruments">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/bus-voltage</property>
                        <value>8.0</value>
                    </gt>
                    <value>3.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

    </channel>

    <!-- ============================================ -->
    <!-- TOTAL BUS LOAD                               -->
    <!-- ============================================ -->
    
    <channel name="Total Load Calculation">

        <!-- Total loads -->
        <fcs_function name="/systems/pa-38/electrical/loads/total">
            <function>
                <sum>
                    <property>/systems/pa-38/electrical/loads/panel-light</property>
					<property>/systems/pa-38/electrical/loads/nav-lights</property>
                    <property>/systems/pa-38/electrical/loads/anti-coll-lights</property>
                    <property>/systems/pa-38/electrical/loads/landing-light</property>
                    <property>/systems/pa-38/electrical/loads/com1</property>
					<property>/systems/pa-38/electrical/loads/nav1</property>
					<property>/systems/pa-38/electrical/loads/adf</property>
					<property>/systems/pa-38/electrical/loads/transponder</property>
                    <property>/systems/pa-38/electrical/loads/fuel-pump</property>
                    <property>/systems/pa-38/electrical/loads/pitot-heat</property>
                    <property>/systems/pa-38/electrical/loads/instruments</property>
					<property>/systems/pa-38/electrical/loads/starter</property>
                </sum>
            </function>
            <clipto>
                <min>0.0</min>
                <max>80.0</max>
            </clipto>
        </fcs_function>

    </channel>

    <!-- ============================================ -->
    <!-- ALTERNATOR SERVICEABLE                       -->
    <!-- ============================================ -->

    <switch name="systems/pa-38/electrical/alternator-serviceable">
        <default value="1"/>
        <!-- No serviceable IF CB is open -->
        <test logic="AND" value="0">
            /controls/circuit-breakers/alt-field LT 1
        </test>
    </switch>

</system>