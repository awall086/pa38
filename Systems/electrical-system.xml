                    <gt>
                        <property>/systems/pa-38/electrical/outputs/fuel-pump</property>
                        <value>0.0</value>
                    </gt>
                    <value>3.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <!-- Pitot Heat - Load: ~12A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/pitot-heat">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/controls/anti-ice/pitot-heat-switch</property>
                            <value>1</value>
                        </eq>
                        <eq>
                            <property>/controls/circuit-breakers/pitot-heat</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
