        <fcs_function name="/systems/pa-38/electrical/outputs/nav1">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/instrumentation/nav[0]/power-btn</property>
