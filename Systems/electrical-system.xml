    <!-- ============================================ -->
    <!-- BATTERY CHANNEL                              -->
    <!-- ============================================ -->
    
    <channel name="Battery Management">

		<fcs_function name="/systems/pa-38/electrical/battery-voltage">

			<function>
				<difference>
					<sum>
						<value>11.6</value>

						<!-- 0.02 * SOC -->
						<product>
							<value>0.02</value>
							<property>/systems/pa-38/electrical/battery-charge-pct</property>
						</product>

						<!-- -0.00005 * SOC^2 -->
						<product>
							<value>-0.00005</value>
							<product>
								<property>/systems/pa-38/electrical/battery-charge-pct</property>
								<property>/systems/pa-38/electrical/battery-charge-pct</property>
							</product>
						</product>
					</sum>
>
					<product>
						<value>0.02</value> 
						<property>/systems/pa-38/electrical/loads/total</property>
					</product>
				</difference>
			</function>
			<clipto>
				<min>10.0</min>
				<max>12.8</max>
			</clipto>
		</fcs_function>

        <fcs_function name="/systems/pa-38/electrical/battery-current">
            <function>
                <ifthen>
                    <eq>
                        <property>/controls/switches/master-batt</property>
                        <value>1</value>
                    </eq>
                    <product>
                        <property>/systems/pa-38/electrical/loads/total</property>
                        <difference>
                            <value>1.0</value>
                            <ifthen>
                                <gt>
                                    <property>/systems/pa-38/electrical/alternator-voltage</property>
                                    <value>13.0</value>
                                </gt>
                                <value>0.9</value>
                                <value>0.0</value>
                            </ifthen>
                        </difference>
                    </product>
                    <value>0.0</value>
                </ifthen>
            </function>
		</fcs_function>

        <!-- Battery charge status (%) -->
        <fcs_function name="/systems/pa-38/electrical/battery-charge-pct">
            <function>
                <ifthen>
                    <eq>
                        <property>/controls/switches/master-batt</property>
                        <value>1</value>
                    </eq>
                    <!-- Charging or discharging the battery depending on whether the alternator is supplying current -->
                    <ifthen>
                        <gt>
                            <property>/systems/pa-38/electrical/alternator-voltage</property>
                            <value>13.0</value>
                        </gt>
                        <!-- Charging the battery with the alternator -->
                        <sum>
							<product>
								<value>0.00028</value>
								<difference>
									<value>100.0</value>
									<property>/systems/pa-38/electrical/battery-charge-pct</property>
								</difference>
							</product>
							<property>/systems/pa-38/electrical/battery-charge-pct</property>
						</sum>
						<!-- Battery discharge based on bus load -->
                        <sum>
							<product>
								<value>-0.00000994</value>
								<property>/systems/pa-38/electrical/loads/total</property>
							</product>
							<property>/systems/pa-38/electrical/battery-charge-pct</property>
						</sum>
                    </ifthen>
                    <property>/systems/pa-38/electrical/battery-charge-pct</property>
                </ifthen>
            </function>
            <clipto>
                <min>0.0</min>
                <max>100.0</max>
            </clipto>
        </fcs_function>
		
    </channel>

    <!-- ============================================ -->
    <!-- ALTERNATOR CHANNEL                           -->
    <!-- ============================================ -->
    
    <channel name="Alternator Management">

        <fcs_function name="/systems/pa-38/electrical/engine-rpm-norm">
            <function>
                <quotient>
					<property>/engines/engine[0]/rpm</property>
                    <value>2600.0</value>
                </quotient>
            </function>
            <clipto>
                <min>0.0</min>
                <max>1.0</max>
            </clipto>
		</fcs_function>

        <!-- Alternator 60A, 14V -->
        <fcs_function name="/systems/pa-38/electrical/alternator-voltage">
            <function>
                <ifthen>
                    <and>
                        <eq>
                            <property>/controls/switches/master-alt</property>
                            <value>1</value>
                        </eq>
                        <eq>
                            <property>/controls/circuit-breakers/alt-field</property>
                            <value>1</value>
                        </eq>
                        <gt>
							<property>/engines/engine[0]/rpm</property>
                            <value>500.0</value>
                        </gt>
                    </and>
                    <!-- Alternator voltage according to engine RPM -->
                    <product>
                        <value>14.2</value>
                        <ifthen>
                            <lt>
                                <property>/systems/pa-38/electrical/engine-rpm-norm</property>
                                <value>0.25</value>
                            </lt>
                            <quotient>
                                <property>/systems/pa-38/electrical/engine-rpm-norm</property>
                                <value>0.25</value>
                            </quotient>
                            <value>1.0</value>
                        </ifthen>
                    </product>
                    <value>0.0</value>
                </ifthen>
            </function>
            <clipto>
                <min>0.0</min>
                <max>14.5</max>
            </clipto>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/alternator-current">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/alternator-voltage</property>
                        <value>10.0</value>
                    </gt>
                    <min>
                        <property>/systems/pa-38/electrical/loads/total</property>
                        <value>60.0</value>
                    </min>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

    </channel>

    <!-- ============================================ -->
    <!-- MAIN BUS VOLTAGE                             -->
    <!-- ============================================ -->
    
    <channel name="Main Bus">

        <!-- Main bus volts -->
        <fcs_function name="/systems/pa-38/electrical/bus-voltage">
            <function>
                <ifthen>
                    <eq>
                        <property>/controls/switches/master-batt</property>
                        <value>1</value>
                    </eq>
                    <ifthen>
                        <gt>
                            <property>/systems/pa-38/electrical/alternator-voltage</property>
                            <value>13.0</value>
                        </gt>
                        <!-- The alternator supplies current -->
                        <property>/systems/pa-38/electrical/alternator-voltage</property>
                        <!-- Only Battery supplies current -->
                        <property>/systems/pa-38/electrical/battery-voltage</property>
                    </ifthen>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

    </channel>

    <!-- ============================================ -->
    <!-- OUTPUTS and LOADS                            -->
    <!-- ============================================ -->
    
    <channel name="Electrical Outputs">

        <!-- Starter - Load: ~14A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/starter">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/controls/switches/starter</property>
                            <value>1</value>
                        </eq>
                        <eq>
                            <property>/controls/circuit-breakers/starter</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/loads/starter">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/starter</property>
                        <value>0.0</value>
                    </gt>
                    <value>14.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function> 

		<!-- Nav Lights - Load: ~5A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/nav-lights">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <gt>
                            <property>/controls/lighting/panel-lights</property>
                            <value>-0.1</value>
                        </gt>
                        <eq>
                            <property>/controls/circuit-breakers/nav_lt</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/loads/nav-lights">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/nav-lights</property>
                        <value>0.0</value>
                    </gt>
                    <value>5.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <!-- Anti-Collision Lights (Strobe Lights) - Load:~4A  -->
        <fcs_function name="/systems/pa-38/electrical/outputs/anti-coll-lights">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/controls/lighting/anti-coll-switch</property>
                            <value>1</value>
                        </eq>
                        <eq>
                            <property>/controls/circuit-breakers/anti-coll_lt</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/loads/anti-coll-lights">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/anti-coll-lights</property>
