        </fcs_function>
		
		<!-- Transponder - Load: ~2.0A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/transponder">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <gt>
                            <property>/instrumentation/transponder/inputs/knob-mode</property>
                            <value>1</value>
                        </gt>
                        <eq>
                            <property>/controls/circuit-breakers/transponder</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>

        <fcs_function name="/systems/pa-38/electrical/loads/transponder">
            <function>
                <ifthen>
                    <gt>
                        <property>/systems/pa-38/electrical/outputs/transponder</property>
                        <value>0.0</value>
                    </gt>
                    <value>2.0</value>
                    <value>0.0</value>
                </ifthen>
            </function>
        </fcs_function>		

        <!-- Fuel Pump - Load: ~3A -->
        <fcs_function name="/systems/pa-38/electrical/outputs/fuel-pump">
            <function>
                <ifthen>
                    <and>
                        <gt>
                            <property>/systems/pa-38/electrical/bus-voltage</property>
                            <value>8.0</value>
                        </gt>
                        <eq>
                            <property>/controls/switches/fuel-pump</property>
                            <value>1</value>
                        </eq>
                        <eq>
                            <property>/controls/circuit-breakers/fuel-pump</property>
                            <value>1</value>
                        </eq>
                    </and>
                    <property>/systems/pa-38/electrical/bus-voltage</property>
                    <value>0.0</value>
