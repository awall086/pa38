<PropertyList>

    <params>
        <doors>
            <right>/sim/multiplay/generic/float[0]</right>
			<left>/sim/multiplay/generic/float[1]</left>
        </doors>
    </params>

    <!-- Return a factor (>= 1.0) to boost the volume when one or both
         doors are open.
    -->
    <filter>
        <name>Volume Boost Doors Factor</name>
        <type>gain</type>
        <input>
            <condition>
                <property>/sim/current-view/internal</property>
            </condition>
            <expression>
                    <product>
						<min>
                            <sum>
                                <!-- Left window fully open is 1.0. Fully closed is 0.0 -->
                                <table>
                                    <property alias="/params/doors/left"/>
                                    <entry><ind>0.0</ind><dep>0.0</dep></entry>
                                    <entry><ind>0.5</ind><dep>0.35</dep></entry>
                                    <entry><ind>1.0</ind><dep>0.7</dep></entry>
                                </table>

                                <!-- Right door fully open is 1.0. Fully closed is 0.0 -->
                                <table>
                                    <property alias="/params/doors/right"/>
                                    <entry><ind>0.0</ind><dep>0.0</dep></entry>
                                    <entry><ind>0.5</ind><dep>0.35</dep></entry>
                                    <entry><ind>1.0</ind><dep>0.7</dep></entry>
                                </table>

                            </sum>
							<value>1.0</value>
						</min>
                        <value>1.4</value>
                    </product>
            </expression>
        </input>
        <input>
            <!-- 60 % extra volume if outside the aircraft -->
            <value>1.6</value>
        </input>
        <output>
            <property>/sim/model/pa38/sound/volume-boost-doors</property>
        </output>
    </filter>

</PropertyList>
